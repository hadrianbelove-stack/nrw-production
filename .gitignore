admin/featured_movies.json
diary/*.md

# Root cleanliness - Amendment 014/017: Seven-file MD whitelist
/*.md
!README.md
!CODEBASE_MAP.md
!SYSTEM_ARCHITECTURE.md
!PROJECT_CHARTER.md
!DAILY_CONTEXT.md
!IMPLEMENTATION_ROADMAP.md
!NRW_DATA_WORKFLOW_EXPLAINED.md

# Block root .txt files except requirements and youtube token
/*.txt
!requirements.txt
!youtube_token_base64.txt

# Block backup scripts and debug files in root
/*.backup
/*.backup-*
/*.bak
/debug.html
/test.html
/nrw*admin*
/nrw*launcher*
plex_config.json
plex_library.json

# Cinefamily calendar PDFs (archival, not code)
CInefamily Calendars/

# Self-hosted trailer video files (large, served via CDN)
media/trailers/

# Hidden gems scraper output (working files)
hidden_gems_output/

# Root cleanliness - prevent one-off report outputs from being committed
/*.xlsx
/*.csv
/*.jpg
/*.png
!/favicon.png
/hidden_gems*
!/hidden_gems_scraper.py
/december_hidden_gems*
/letterboxd_vod_*.json
