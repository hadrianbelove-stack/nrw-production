.venv/
*.pyc
__pycache__/
.DS_Store
# Keep API keys local only (file is tracked; secret fields kept blank)
config.yaml
# Alternative secrets storage
.env
# Local configuration with secrets
config.ini

# tvOS TestFlight: local credentials + build artifacts (never commit secrets)
NRWApp-tvOS/.testflight.env
NRWApp-tvOS/build/
*.p8

# /reviewsince marker — personal "last reviewed commit" pointer
.claude/last_review_commit
# /cleanupcatchup marker — personal "last caught-up commit" pointer
.claude/last_catchup_commit
# /cleanupcatchup --report-only marker + pending-findings ledger (advanced daily by /morning)
.claude/last_reported_commit
.claude/catchup_findings.md
cache/*
!cache/.gitkeep
!cache/screenshots/
cache/screenshots/*
!cache/screenshots/.gitkeep

# Log files
logs/
*.log

# Backup files from safe_write_json
*.backup.*
backups/*
!backups/.gitkeep
/data.json.backup
/data.json.corrupted.*
/data.json.pre_test*
/data.json.quarantine.*
diagnose_*.py
current_releases.json
*_test.py
verify_*.py
verification_report.json
NRW_SYNC_*.zip
NRW_SYNC_*.sha256
NRW_SYNC_*.manifest*
bundle_history/
snapshot_history/
*.zip
*.sha256
*.manifest.txt
WORKING_SET_HANDOFF_*/
_ws_*/
sync_tmp_*/
output/
.nrw_http_pid

# Cache files (ephemeral data) - now organized under cache/
*_cache.json
cache/*.json
!cache/wikipedia_cache.json
# Restoration version-gate verdicts: CI runners are stateless — an uncommitted
# cache would re-buy the same grounded Gemini verdicts every day.
!cache/restoration_vod_cache.json
# Pass F seen-ledger: which news headlines were already processed. Uncommitted,
# every stateless CI run would re-process the whole feed window.
!cache/googlenews_seen.json
# Curation caches (pull_quotes_combined.json, capsule_cache.json) stay IGNORED:
# CI generates them and ships them via the "curation-caches" artifact, which
# local_daily.sh merges in. They are deliberately NOT tracked.
# The hand-curated capsule bank lives at admin/approved_capsules.json and IS
# git-tracked (CI reads it for house-style few-shot generation; only the local
# approve flow writes it). cache/approved_capsules.json is a transition symlink.
cache/screenshots/*.png
cache/screenshots/*.html
# Legacy cache file locations (for backwards compatibility)
rt_cache.json
wikipedia_cache.json
youtube_trailer_cache.json
watchmode_quota.json

# Orchestrator lock file
.nrw_orchestrator.lock


# Scraper health metrics (generated)
metrics/scraper_health.json
metrics/scraper_health_history.jsonl

