# SQLite tracking database (local-only — movie_tracking.json is the Git artifact)
/movie_tracking.db
/movie_tracking.db-wal
/movie_tracking.db-shm

# Per-movie share assets — regenerated in CI before deploy (never committed)
/m/
/assets/cards/

