target 'NRWApp-tvOS' do
  config = use_native_modules!
  platform :tvos, '14.0'

  use_react_native!(
    :path => config[:reactNativePath],
    # Enables Flipper.
    #
    # Note that if you have use_frameworks! enabled, Flipper will not work and
    # you should disable the next line.
    :flipper_configuration => flipper_config,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  script_phase :name => 'Generate Hermes dSYM',
    :script => <<-SCRIPT,
      if [ "${CONFIGURATION}" = "Release" ]; then
        HERMES_XCFWK="${PODS_XCFRAMEWORKS_BUILD_DIR}/hermes-engine/Pre-built/hermes.framework/hermes"
        if [ -f "$HERMES_XCFWK" ]; then
          /usr/bin/dsymutil "$HERMES_XCFWK" -o "${DWARF_DSYM_FOLDER_PATH}/hermes.framework.dSYM"
        fi
      fi
    SCRIPT
    :execution_position => :after_compile

  target 'NRWApp-tvOSTests' do
    inherit! :complete
    # Pods for testing
  end

end

post_install do |installer|
  # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
  config = use_native_modules!
  react_native_post_install(
    installer,
    config[:reactNativePath],
    :mac_catalyst_enabled => false
  )

  # Bump pod deployment targets to avoid deprecation warnings with modern Xcode
  # Also generate dSYMs for all pods (fixes Hermes dSYM missing on archive upload)
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if config.build_settings['TVOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['TVOS_DEPLOYMENT_TARGET'] = '15.0'
      end
      config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
    end
  end
end
