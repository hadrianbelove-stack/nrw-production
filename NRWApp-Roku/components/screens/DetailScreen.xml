<?xml version="1.0" encoding="utf-8" ?>
<!--
  NRW Detail Screen
  Full-screen movie details with poster and metadata
  Matches tvOS MovieDetail.tvos.js and Android DetailScreen.kt
-->
<component name="DetailScreen" extends="Group">
  <interface>
    <!-- Input -->
    <field id="movies" type="array" onChange="onMoviesChanged" />
    <field id="currentIndex" type="integer" value="0" onChange="onIndexChanged" />

    <!-- Output -->
    <field id="closed" type="boolean" value="false" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="DetailScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/constants/Colors.brs" />
  <script type="text/brightscript" uri="pkg:/source/constants/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/MovieUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/DeepLinkUtils.brs" />

  <children>
    <!-- Full screen background -->
    <Rectangle id="background"
      width="1920"
      height="1080"
      color="0x0A0A0AFF" />

    <!-- Backdrop image (if available) -->
    <Poster id="backdrop"
      width="1920"
      height="1080"
      loadDisplayMode="scaleToZoom"
      opacity="0.3"
      visible="false" />

    <!-- Gradient overlay -->
    <Rectangle id="gradientOverlay"
      width="1920"
      height="1080"
      color="0x0A0A0A00" />

    <!-- Content container -->
    <LayoutGroup id="contentLayout"
      layoutDirection="horiz"
      translation="[80, 60]"
      itemSpacings="[60]">

      <!-- Left: Large poster -->
      <Group id="posterContainer">
        <Rectangle id="posterBorder"
          width="606"
          height="916"
          color="0x00D4AA40" />
        <Poster id="moviePoster"
          width="600"
          height="900"
          translation="[3, 3]"
          loadDisplayMode="scaleToZoom" />

        <!-- Trailer overlay on poster (#10: dim + red border + circle + text) -->
        <Rectangle id="trailerOverlayDim"
          width="600"
          height="900"
          translation="[3, 3]"
          color="0x00000073"
          visible="false" />
        <Poster id="trailerOverlayCircle"
          width="80"
          height="80"
          translation="[263, 380]"
          uri=""
          visible="false" />
        <Rectangle id="trailerCircleBg"
          width="80"
          height="80"
          translation="[263, 380]"
          color="0xE50914FF"
          visible="false" />
        <Label id="trailerOverlayText"
          text="TRAILER"
          width="600"
          height="40"
          translation="[3, 470]"
          horizAlign="center"
          vertAlign="center"
          font="font:MediumBoldSystemFont"
          color="0xFFFFFFFF"
          visible="false" />

        <!-- Staff Pick badge (top of poster, matching tvOS/iOS top-left placement) -->
        <Rectangle id="staffPickBadge"
          width="600"
          height="40"
          translation="[3, 8]"
          color="0x00D4AAFF"
          visible="false" />
        <Label id="staffPickLabel"
          text="★ NRW SELECT ★"
          width="600"
          height="40"
          translation="[3, 8]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallBoldSystemFont"
          color="0xFFFFFFFF"
          visible="false" />

        <!-- Restoration badge -->
        <Rectangle id="restorationBadge"
          width="600"
          height="40"
          translation="[3, 826]"
          color="0xC8A951FF"
          visible="false" />
        <Label id="restorationLabel"
          text="RESTORED"
          width="600"
          height="40"
          translation="[3, 826]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallBoldSystemFont"
          color="0x000000FF"
          visible="false" />

        <!-- Pre-order badge (top of poster) -->
        <Rectangle id="preOrderBadge"
          width="600"
          height="60"
          translation="[3, 8]"
          color="0x7C3AEDFF"
          visible="false" />
        <Label id="preOrderLabel"
          text="PRE-ORDER"
          width="600"
          height="30"
          translation="[3, 8]"
          horizAlign="center"
          vertAlign="bottom"
          font="font:SmallBoldSystemFont"
          color="0xFFFFFFFF"
          visible="false" />
        <Label id="preOrderDateLabel"
          text=""
          width="600"
          height="26"
          translation="[3, 36]"
          horizAlign="center"
          vertAlign="top"
          font="font:SmallSystemFont"
          color="0xFFFFFFFF"
          visible="false" />

        <!-- Virtual screening name banner (gold bar) -->
        <Rectangle id="screeningBadge"
          width="600"
          height="36"
          translation="[3, 786]"
          color="0xFFD700FF"
          visible="false" />
        <Label id="screeningLabel"
          width="600"
          height="36"
          translation="[3, 786]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallBoldSystemFont"
          color="0x000000FF"
          visible="false" />

      </Group>

      <!-- Right: Details panel -->
      <LayoutGroup id="detailsPanel"
        layoutDirection="vert"
        itemSpacings="[16]"
        translation="[0, 40]">

        <!-- Title row: title left, date right -->
        <LayoutGroup id="titleRow"
          layoutDirection="horiz"
          horizAlignment="left"
          itemSpacings="[16]">
          <Label id="titleLabel"
            width="900"
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
            wrap="true"
            maxLines="2" />
          <Label id="dateLabel"
            width="200"
            font="font:LargeBoldSystemFont"
            color="0x00D4AAFF"
            horizAlign="right" />
        </LayoutGroup>

        <!-- Title underline -->
        <Rectangle id="titleUnderline"
          width="1100"
          height="2"
          color="0x00D4AA66" />

        <!-- Crew lines: Director + Cast (teal label, white name) -->
        <LayoutGroup id="crewGroup" layoutDirection="vert" itemSpacings="[4]">
          <LayoutGroup id="directorRow" layoutDirection="horiz">
            <Label id="directorLabel" font="font:MediumBoldSystemFont" color="0x00D4AAFF" />
            <Label id="directorName" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
          </LayoutGroup>
          <LayoutGroup id="castRow" layoutDirection="horiz">
            <Label id="castLabel" font="font:MediumBoldSystemFont" color="0x00D4AAFF" />
            <Label id="castName" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
          </LayoutGroup>
        </LayoutGroup>

        <!-- Metadata line: Country • Year • Runtime • Studio -->
        <Label id="metadataLabel"
          width="1100"
          font="font:MediumSystemFont"
          color="0xBBBBBBFF" />

        <!-- Language (if not English) -->
        <Label id="languageLabel"
          width="1100"
          font="font:SmallSystemFont"
          color="0x666666FF"
          visible="false" />

        <!-- Pull Quotes -->
        <Label id="pullQuotesLabel"
          width="1100"
          font="font:SmallSystemFont"
          color="0xAAAAAAFF"
          wrap="true"
          maxLines="6"
          visible="false" />

        <!-- Synopsis — MultiStyleLabel renders **bold**/*italic* (styles set in init via drawingStyles) -->
        <MultiStyleLabel id="synopsisLabel"
          width="1100"
          height="300"
          wrap="true"
          maxLines="8"
          ellipsisText="..." />

        <!-- Buttons row -->
        <LayoutGroup id="buttonsRow"
          layoutDirection="horiz"
          itemSpacings="[16]"
          translation="[0, 20]">

          <!-- Trailer button -->
          <WatchButton id="trailerButton"
            service="youtube"
            label="Trailer"
            buttonType="filled" />

          <!-- VOD label + buttons (rent/buy — before streaming) -->
          <Label id="vodSectionLabel"
            text="Rent/Buy:"
            font="font:SmallSystemFont"
            color="0x00D4AAFF"
            visible="false" />
          <WatchButton id="vodButton1"
            visible="false" />
          <WatchButton id="vodButton2"
            visible="false" />

          <!-- Stream label + buttons (one per free stream) -->
          <Label id="streamSectionLabel"
            text="Stream:"
            font="font:SmallSystemFont"
            color="0x00D4AAFF"
            visible="false" />
          <WatchButton id="streamButton"
            visible="false" />
          <WatchButton id="streamButton2"
            visible="false" />

          <!-- Plex button -->
          <WatchButton id="plexButton"
            service="plex"
            label="Plex"
            visible="false" />
        </LayoutGroup>

        <!-- Scores row: RT + MC + IMDb (display-only, no Wiki on TV) -->
        <LayoutGroup id="infoRow"
          layoutDirection="horiz"
          itemSpacings="[24]"
          translation="[0, 10]"
          visible="false">

          <!-- RT: tomato icon + score + freshness label -->
          <LayoutGroup id="rtGroup"
            layoutDirection="horiz"
            itemSpacings="[8]"
            visible="false">
            <Poster id="rtLogoPoster"
              width="32" height="32"
              uri="pkg:/images/icons/logo_rt.png"
              loadDisplayMode="scaleToFit" />
            <LayoutGroup id="rtScoreCol"
              layoutDirection="vert"
              itemSpacings="[0]">
              <Label id="rtScoreLabel"
                font="font:MediumBoldSystemFont"
                color="0xFFFFFFFF" />
              <Label id="rtFreshnessLabel"
                font="font:SmallBoldSystemFont"
                color="0xFA3232FF" />
            </LayoutGroup>
          </LayoutGroup>

          <!-- MC: colored score box + M logo + wordmark -->
          <LayoutGroup id="mcGroup"
            layoutDirection="horiz"
            itemSpacings="[8]"
            visible="false">
            <Group id="mcScoreBoxGroup">
              <Rectangle id="mcScoreBox"
                width="44" height="44"
                color="0x66CC33FF" />
              <Label id="mcScoreLabel"
                width="44" height="44"
                horizAlign="center"
                vertAlign="center"
                font="font:MediumBoldSystemFont"
                color="0xFFFFFFFF" />
            </Group>
            <LayoutGroup id="mcLabelCol"
              layoutDirection="vert"
              itemSpacings="[2]">
              <Poster id="mcLogoPoster"
                width="20" height="20"
                uri="pkg:/images/icons/logo_mc.png"
                loadDisplayMode="scaleToFit" />
              <Label id="mcWordLabel"
                text="METACRITIC"
                font="font:SmallSystemFont"
                color="0xFFFFFF80" />
            </LayoutGroup>
          </LayoutGroup>

          <!-- IMDb: logo + score -->
          <LayoutGroup id="imdbGroup"
            layoutDirection="horiz"
            itemSpacings="[8]"
            visible="false">
            <Poster id="imdbLogoPoster"
              width="40" height="20"
              uri="pkg:/images/icons/logo_imdb.png"
              loadDisplayMode="scaleToFit" />
            <Label id="imdbScoreLabel"
              font="font:MediumBoldSystemFont"
              color="0xF5C518FF" />
          </LayoutGroup>

          <!-- Letterboxd: logo + star glyphs -->
          <LayoutGroup id="lbGroup"
            layoutDirection="horiz"
            itemSpacings="[8]"
            visible="false">
            <Poster id="lbLogoPoster"
              width="32" height="32"
              uri="pkg:/images/icons/logo_letterboxd.png"
              loadDisplayMode="scaleToFit"
              blendColor="0x00E054FF" />
            <Label id="lbScoreLabel"
              font="font:MediumBoldSystemFont"
              color="0x00E054FF" />
          </LayoutGroup>
        </LayoutGroup>
      </LayoutGroup>
    </LayoutGroup>

    <!-- Navigation chevrons -->
    <Label id="leftChevron"
      text="‹"
      translation="[20, 500]"
      font="font:LargeBoldSystemFont"
      color="0x00D4AA99" />
    <Label id="rightChevron"
      text="›"
      translation="[1880, 500]"
      font="font:LargeBoldSystemFont"
      color="0x00D4AA99" />

    <!-- Movie counter -->
    <Label id="counterLabel"
      translation="[1800, 40]"
      font="font:SmallSystemFont"
      color="0x888888FF"
      horizAlign="right" />

    <!-- Trailer player (self-hosted MP4) -->
    <TrailerPlayer id="trailerPlayer" visible="false" />
  </children>
</component>
