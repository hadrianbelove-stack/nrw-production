<?xml version="1.0" encoding="utf-8" ?>
<!--
  NRW Home Screen
  Main screen with 8-column grid of movie posters
  Matches tvOS HomeScreen.tvos.js and Android HomeScreen.kt
-->
<component name="HomeScreen" extends="Scene">
  <interface>
    <!-- Deep link support -->
    <field id="deepLinkMovieId" type="string" onChange="onDeepLink" />
  </interface>

  <script type="text/brightscript" uri="HomeScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/constants/Colors.brs" />
  <script type="text/brightscript" uri="pkg:/source/constants/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/api/NRWApi.brs" />
  <script type="text/brightscript" uri="pkg:/source/api/CacheManager.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/MovieUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/DeepLinkUtils.brs" />

  <children>
    <!-- Background -->
    <Rectangle id="background"
      width="1920"
      height="1080"
      color="0x0A0A0AFF" />

    <!-- Header -->
    <LayoutGroup id="header"
      layoutDirection="horiz"
      translation="[100, 48]"
      itemSpacings="[0]">

      <!-- Title + slogan -->
      <LayoutGroup layoutDirection="vert" itemSpacings="[4]">
        <Label id="titleLabel"
          text="THE NEW RELEASE WALL"
          font="font:LargeBoldSystemFont"
          color="0xFFFFFFFF" />
        <Label id="sloganLabel"
          text="Bringing back browsing. What came out, every day."
          font="font:MediumSystemFont"
          color="0x00D4AAFF" />
      </LayoutGroup>

      <!-- Spacer -->
      <Rectangle width="800" height="1" color="0x00000000" />

      <!-- Search button — lights up when the filter row is focused (▲ to open) -->
      <Group id="searchButton">
        <Rectangle id="searchButtonBg" width="200" height="40" color="0x333333FF" />
        <Label id="searchButtonLabel" text="Search…"
          width="200"
          height="40"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallSystemFont"
          color="0x888888FF" />
      </Group>
    </LayoutGroup>

    <!-- Filter bar -->
    <FilterBar id="filterBar"
      translation="[0, 150]" />

    <!-- Loading indicator -->
    <LayoutGroup id="loadingGroup"
      layoutDirection="vert"
      horizAlignment="center"
      translation="[960, 500]"
      visible="true">
      <BusySpinner id="loadingSpinner" visible="true" />
      <Label id="loadingLabel"
        text="Loading movies..."
        font="font:MediumSystemFont"
        color="0xBBBBBBFF"
        translation="[0, 20]" />
    </LayoutGroup>

    <!-- Error message -->
    <LayoutGroup id="errorGroup"
      layoutDirection="vert"
      horizAlignment="center"
      translation="[960, 500]"
      visible="false">
      <Label id="errorLabel"
        text="Failed to load movies"
        font="font:MediumBoldSystemFont"
        color="0xFF3B30FF" />
      <Label id="errorRetry"
        text="Press OK to retry"
        font="font:SmallSystemFont"
        color="0xBBBBBBFF"
        translation="[0, 10]" />
    </LayoutGroup>

    <!-- Filter description (shown when exactly 1 filter active) -->
    <Group id="filterDescGroup" translation="[80, 178]" visible="false">
      <Label id="filterDescTitle"
        font="font:SmallBoldSystemFont"
        color="0x00D4AAFF" />
      <Label id="filterDescText"
        width="1700"
        translation="[0, 22]"
        font="font:SmallSystemFont"
        color="0x888888FF"
        wrap="true"
        maxLines="2" />
    </Group>

    <!-- Heads-up date banner: neon bar that tracks the focused row's date group -->
    <Group id="dateHud" translation="[100, 240]" visible="false">
      <Rectangle id="dateHudTop" width="1720" height="3" color="0x00D4AAFF" />
      <Rectangle id="dateHudBg" width="1720" height="58" translation="[0, 3]" color="0x08080CF5" />
      <Label id="dateHudDay" width="846" height="58" translation="[0, 3]"
        horizAlign="right" vertAlign="center"
        font="font:MediumBoldSystemFont" color="0x00D4AAFF" />
      <Label id="dateHudRest" width="846" height="58" translation="[874, 3]"
        horizAlign="left" vertAlign="center"
        font="font:MediumSystemFont" color="0xFFFFFFFF" />
      <Rectangle id="dateHudBottom" width="1720" height="3" translation="[0, 61]" color="0x00D4AAFF" />
    </Group>

    <!-- Movie grid: date groups are sections; dividers render as full-width strips -->
    <MarkupGrid id="movieGrid"
      translation="[100, 320]"
      visible="false"
      itemComponentName="MovieCard"
      numColumns="5"
      itemSize="[328, 516]"
      itemSpacing="[20, 20]"
      sectionDividerFont="font:MediumBoldSystemFont"
      sectionDividerTextColor="0x00D4AAFF"
      sectionDividerHeight="72"
      sectionDividerSpacing="14"
      sectionDividerMinWidth="1720"
      drawFocusFeedback="false"
      vertFocusAnimationStyle="floatingFocus" />

    <!-- Trailers button (first item in grid area) -->
    <Group id="trailersButton"
      translation="[60, 240]"
      visible="false">
      <Rectangle width="200" height="300" color="0x1A1A2EFF" />
      <Rectangle width="196" height="296" translation="[2, 2]" color="0x0A0A0AFF" />
      <Label text="TRAILERS"
        width="200"
        height="300"
        horizAlign="center"
        vertAlign="center"
        font="font:MediumBoldSystemFont"
        color="0x00D4AAFF" />
    </Group>

    <!-- Detail screen (overlay) -->
    <DetailScreen id="detailScreen"
      visible="false" />

    <!-- Search screen (overlay) -->
    <SearchScreen id="searchScreen"
      visible="false" />
  </children>
</component>
