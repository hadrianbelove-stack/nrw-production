<?xml version="1.0" encoding="utf-8" ?>
<!--
  NRW Watch Button Component
  Service-colored outline button for streaming services
  Matches Android WatchButton.kt styling
-->
<component name="WatchButton" extends="Group">
  <interface>
    <!-- Button configuration -->
    <field id="service" type="string" onChange="onServiceChanged" />
    <field id="label" type="string" onChange="onLabelChanged" />
    <field id="url" type="string" />
    <field id="buttonType" type="string" value="outline" /> <!-- "outline" or "filled" -->

    <!-- Focus state -->
    <field id="focusPercent" type="float" value="0.0" onChange="onFocusChanged" />

    <!-- Price data -->
    <field id="rentPrice" type="string" value="" onChange="onPriceChanged" />
    <field id="buyPrice" type="string" value="" onChange="onPriceChanged" />

    <!-- Output -->
    <field id="selected" type="boolean" value="false" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="WatchButton.brs" />
  <script type="text/brightscript" uri="pkg:/source/constants/Colors.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/MovieUtils.brs" />

  <children>
    <!-- Button container — V2: logo left, prices right (when prices exist) -->
    <Group id="buttonContainer">
      <!-- Button background (full width default, shrunk to left half when prices present) -->
      <Rectangle id="buttonBg"
        width="140"
        height="44"
        color="0x00000000" />

      <!-- Button border (for services like Apple TV) -->
      <Rectangle id="buttonBorder"
        width="140"
        height="44"
        color="0x00000000">
        <Rectangle id="buttonInner"
          width="136"
          height="40"
          translation="[2, 2]"
          color="0x0A0A0AFF" />
      </Rectangle>

      <!-- Service icon (in logo area) -->
      <Poster id="serviceIcon"
        width="24"
        height="24"
        translation="[12, 10]"
        visible="false" />

      <!-- Button label (full width default, shrunk when prices present) -->
      <Label id="buttonLabel"
        width="140"
        height="44"
        horizAlign="center"
        vertAlign="center"
        font="font:SmallBoldSystemFont"
        color="0xFFFFFFFF" />

      <!-- V2 Price area (right half, stacked vertically — positioned dynamically) -->
      <LayoutGroup id="priceBar"
        layoutDirection="vert"
        translation="[140, 0]"
        visible="false">
        <Rectangle id="rentPriceBg" width="70" height="22" color="0xFFAD33FF">
          <Label id="rentPriceLabel" width="70" height="22"
            horizAlign="center" vertAlign="center"
            font="font:SmallestSystemFont" color="0x000000FF" />
        </Rectangle>
        <Rectangle id="buyPriceBg" width="70" height="22" color="0xE68A00FF">
          <Label id="buyPriceLabel" width="70" height="22"
            horizAlign="center" vertAlign="center"
            font="font:SmallestSystemFont" color="0x000000FF" />
        </Rectangle>
      </LayoutGroup>
    </Group>
  </children>
</component>
