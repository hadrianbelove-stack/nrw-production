<?xml version="1.0" encoding="utf-8" ?>
<!--
  NRW Date Divider Card Component
  Card-style date divider matching mobile web design:
  teal bar + day number + month + cascading chevrons
-->
<component name="DateDivider" extends="Group">
  <interface>
    <field id="dateString" type="string" onChange="onDateChanged" />
  </interface>

  <script type="text/brightscript" uri="DateDivider.brs" />

  <children>
    <!-- Card container (same size as movie cards: 200x300) -->
    <Group id="cardContainer">
      <!-- Card background -->
      <Rectangle id="cardBg"
        width="200"
        height="300"
        color="0x0A0A0AFF" />

      <!-- Top bar (teal for dates, purple for pre-order) -->
      <Rectangle id="topBar"
        width="200"
        height="24"
        color="0x00D4AAFF" />
      <Label id="topBarLabel"
        width="196"
        height="24"
        translation="[4, 0]"
        vertAlign="center"
        font="font:SmallBoldSystemFont"
        color="0x000000FF" />

      <!-- Day number (large) -->
      <Label id="dayNumber"
        width="200"
        height="80"
        translation="[8, 80]"
        vertAlign="center"
        font="font:LargeBoldSystemFont"
        color="0xFFFFFFFF" />

      <!-- Month label -->
      <Label id="monthLabel"
        width="200"
        height="24"
        translation="[8, 155]"
        vertAlign="center"
        font="font:SmallSystemFont"
        color="0x888888FF" />

      <!-- Chevrons row -->
      <Label id="chevron1"
        text="›"
        width="24"
        height="40"
        translation="[8, 185]"
        vertAlign="center"
        font="font:LargeBoldSystemFont"
        color="0x00D4AAE6" />
      <Label id="chevron2"
        text="›"
        width="24"
        height="40"
        translation="[28, 185]"
        vertAlign="center"
        font="font:LargeBoldSystemFont"
        color="0x00D4AAB3" />
      <Label id="chevron3"
        text="›"
        width="24"
        height="40"
        translation="[48, 185]"
        vertAlign="center"
        font="font:LargeBoldSystemFont"
        color="0x00D4AA80" />
      <Label id="chevron4"
        text="›"
        width="24"
        height="40"
        translation="[68, 185]"
        vertAlign="center"
        font="font:LargeBoldSystemFont"
        color="0x00D4AA4D" />
      <Label id="chevron5"
        text="›"
        width="24"
        height="40"
        translation="[88, 185]"
        vertAlign="center"
        font="font:LargeBoldSystemFont"
        color="0x00D4AA26" />
    </Group>
  </children>
</component>
