<?xml version="1.0" encoding="utf-8" ?>
<!--
  NRW Movie Card Component
  Displays movie poster with badges and focus states
  Matches tvOS MovieCard.tvos.js and Android MovieCard.kt
-->
<component name="MovieCard" extends="Group">
  <interface>
    <!-- Input fields -->
    <field id="movie" type="assocarray" onChange="onMovieChanged" />
    <field id="cardIndex" type="integer" value="0" />

    <!-- Focus state -->
    <field id="focusPercent" type="float" value="0.0" onChange="onFocusChanged" />

    <!-- Output events -->
    <field id="selected" type="boolean" value="false" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="MovieCard.brs" />
  <script type="text/brightscript" uri="pkg:/source/constants/Colors.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/MovieUtils.brs" />

  <children>
    <!-- Card container (for scaling on focus) -->
    <LayoutGroup id="cardContainer" layoutDirection="vert" horizAlignment="center">

      <!-- Poster container with border -->
      <Group id="posterGroup">
        <!-- Focus border (behind poster) -->
        <Rectangle id="focusBorder"
          width="206"
          height="312"
          color="0x00D4AAFF"
          visible="false"
          translation="[-3, -3]" />

        <!-- Staff pick border (behind poster, red) -->
        <Rectangle id="staffPickBorder"
          width="206"
          height="312"
          color="0xDC143CFF"
          visible="false"
          translation="[-3, -3]" />

        <!-- Virtual screening border (behind poster, gold) -->
        <Rectangle id="screeningBorder"
          width="206"
          height="312"
          color="0xFFD700FF"
          visible="false"
          translation="[-3, -3]" />

        <!-- Card background -->
        <Rectangle id="cardBackground"
          width="200"
          height="306"
          color="0x1A1A1AFF" />

        <!-- Movie poster -->
        <Poster id="poster"
          width="200"
          height="300"
          loadDisplayMode="scaleToZoom"
          loadingBitmapUri="pkg:/images/icons/placeholder.png"
          failedBitmapUri="pkg:/images/icons/placeholder.png" />

        <!-- Streaming service bar badge (full-width top bar) -->
        <Rectangle id="serviceBadgeBg"
          width="200"
          height="24"
          translation="[0, 0]"
          color="0xE50914FF"
          visible="false" />
        <Label id="serviceBadge"
          width="200"
          height="24"
          translation="[0, 0]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallBoldSystemFont"
          color="0xFFFFFFFF"
          visible="false" />

        <!-- Pre-order badge (top-right, replaces streaming badge) -->
        <Rectangle id="preOrderBadgeBg"
          width="56"
          height="32"
          translation="[140, 4]"
          color="0x7C3AEDFF"
          visible="false" />
        <Label id="preOrderBadgeLabel"
          width="56"
          height="18"
          translation="[140, 4]"
          horizAlign="center"
          vertAlign="bottom"
          font="font:SmallBoldSystemFont"
          color="0xFFFFFFFF"
          visible="false" />
        <Label id="preOrderBadgeDate"
          width="56"
          height="16"
          translation="[140, 18]"
          horizAlign="center"
          vertAlign="top"
          font="font:SmallSystemFont"
          color="0xFFFFFFFF"
          visible="false" />

        <!-- Restoration badge (top-left) -->
        <Rectangle id="restorationBadgeBg"
          width="64"
          height="22"
          translation="[4, 4]"
          color="0xC8A951FF"
          visible="false" />
        <Label id="restorationBadgeLabel"
          text="RESTORED"
          width="64"
          height="22"
          translation="[4, 4]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallBoldSystemFont"
          color="0x000000FF"
          visible="false" />

        <!-- Virtual screening top banner (full width, top of poster) -->
        <Rectangle id="screeningTopBannerBg"
          width="200"
          height="22"
          translation="[0, 0]"
          color="0xFFD700EB"
          visible="false" />
        <Label id="screeningTopBannerLabel"
          text="VIRTUAL SCREENING"
          width="200"
          height="22"
          translation="[0, 0]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallBoldSystemFont"
          color="0x000000FF"
          visible="false" />

        <!-- Virtual screening festival name strip (bottom of poster) -->
        <Rectangle id="screeningFestivalBg"
          width="200"
          height="24"
          translation="[0, 276]"
          color="0xFFD700FF"
          visible="false" />
        <Label id="screeningFestivalLabel"
          width="196"
          height="24"
          translation="[2, 276]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallBoldSystemFont"
          color="0x000000FF"
          visible="false" />

        <!-- Metacritic score badge (bottom, left of IMDb) -->
        <Rectangle id="mcBadgeBg"
          width="40"
          height="22"
          translation="[72, 274]"
          color="0x000000B3"
          visible="false" />
        <Label id="mcBadge"
          width="40"
          height="22"
          translation="[72, 274]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallSystemFont"
          color="0x66CC33FF"
          visible="false" />

        <!-- IMDb rating badge (bottom-right, left of RT) -->
        <Rectangle id="imdbBadgeBg"
          width="36"
          height="22"
          translation="[116, 274]"
          color="0x000000B3"
          visible="false" />
        <Label id="imdbBadge"
          width="36"
          height="22"
          translation="[116, 274]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallSystemFont"
          color="0xF5C518FF"
          visible="false" />

        <!-- RT score badge (bottom-right) -->
        <Rectangle id="rtBadgeBg"
          width="44"
          height="22"
          translation="[152, 274]"
          color="0x000000B3"
          visible="false" />
        <Label id="rtBadge"
          width="44"
          height="22"
          translation="[152, 274]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallSystemFont"
          color="0xFF6B6BFF"
          visible="false" />

        <!-- Staff Pick strip (bottom) -->
        <Rectangle id="staffPickStrip"
          width="200"
          height="6"
          translation="[0, 300]"
          color="0xDC143CFF"
          visible="false" />
      </Group>

      <!-- Director name (below poster) -->
      <Label id="directorLabel"
        width="200"
        height="24"
        translation="[0, 6]"
        horizAlign="center"
        font="font:SmallSystemFont"
        color="0xBBBBBBFF"
        maxLines="1"
        ellipsisText="..." />

    </LayoutGroup>

    <!-- Date divider card (hidden by default, shown for date items) -->
    <Group id="dateDividerGroup" visible="false">
      <Rectangle id="dateDividerBg"
        width="200"
        height="300"
        color="0x0A0A0AFF" />
      <Rectangle id="dateDividerBar"
        width="200"
        height="24"
        color="0x00D4AAFF" />
      <Label id="dateDividerBarLabel"
        width="196"
        height="24"
        translation="[4, 0]"
        vertAlign="center"
        font="font:SmallBoldSystemFont"
        color="0x000000FF" />
      <Label id="dateDividerNumber"
        width="200"
        height="80"
        translation="[8, 80]"
        vertAlign="center"
        font="font:LargeBoldSystemFont"
        color="0xFFFFFFFF" />
      <Label id="dateDividerMonth"
        width="200"
        height="24"
        translation="[8, 155]"
        vertAlign="center"
        font="font:SmallSystemFont"
        color="0x888888FF" />
      <Label id="dateDividerChevron1"
        text="›" width="24" height="40" translation="[8, 185]"
        vertAlign="center" font="font:LargeBoldSystemFont" color="0x00D4AAE6" />
      <Label id="dateDividerChevron2"
        text="›" width="24" height="40" translation="[28, 185]"
        vertAlign="center" font="font:LargeBoldSystemFont" color="0x00D4AAB3" />
      <Label id="dateDividerChevron3"
        text="›" width="24" height="40" translation="[48, 185]"
        vertAlign="center" font="font:LargeBoldSystemFont" color="0x00D4AA80" />
      <Label id="dateDividerChevron4"
        text="›" width="24" height="40" translation="[68, 185]"
        vertAlign="center" font="font:LargeBoldSystemFont" color="0x00D4AA4D" />
      <Label id="dateDividerChevron5"
        text="›" width="24" height="40" translation="[88, 185]"
        vertAlign="center" font="font:LargeBoldSystemFont" color="0x00D4AA26" />
    </Group>

  </children>
</component>
