<?xml version="1.0" encoding="utf-8" ?>
<!--
  NRW Movie Card Component
  Displays movie poster with badges and focus states
  Matches tvOS MovieCard.tvos.js and Android MovieCard.kt
  Dimensions: 320×480 poster (1.6× scale to fill 344×516 grid cell)
-->
<component name="MovieCard" extends="Group">
  <interface>
    <!-- Input fields -->
    <!-- MarkupGrid delivers each item's ContentNode here; declaring it (like
         focusPercent) ensures the onChange observer fires reliably. -->
    <field id="itemContent" type="node" onChange="onMovieChanged" />
    <field id="movie" type="assocarray" onChange="onMovieChanged" />
    <field id="cardIndex" type="integer" value="0" />

    <!-- Focus state -->
    <field id="focusPercent" type="float" value="0.0" onChange="onFocusChanged" />

    <!-- Output events -->
    <field id="selected" type="boolean" value="false" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="MovieCard.brs" />
  <script type="text/brightscript" uri="pkg:/source/constants/Colors.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/MovieUtils.brs" />

  <children>
    <!-- Card container (for scaling on focus) -->
    <LayoutGroup id="cardContainer" layoutDirection="vert" horizAlignment="center">

      <!-- Poster container with border -->
      <Group id="posterGroup">
        <!-- Focus border (behind poster) -->
        <Rectangle id="focusBorder"
          width="330"
          height="499"
          color="0x00D4AAFF"
          visible="false"
          translation="[-5, -5]" />

        <!-- Staff pick border (behind poster, red) -->
        <Rectangle id="staffPickBorder"
          width="330"
          height="499"
          color="0x00D4AAFF"
          visible="false"
          translation="[-5, -5]" />

        <!-- Virtual screening border (behind poster, gold) -->
        <Rectangle id="screeningBorder"
          width="330"
          height="499"
          color="0xFFD700FF"
          visible="false"
          translation="[-5, -5]" />

        <!-- Card background -->
        <Rectangle id="cardBackground"
          width="320"
          height="490"
          color="0x1A1A1AFF" />

        <!-- Movie poster -->
        <Poster id="poster"
          width="320"
          height="480"
          loadDisplayMode="scaleToZoom"
          loadingBitmapUri="pkg:/images/icons/placeholder.png"
          failedBitmapUri="pkg:/images/icons/placeholder.png" />

        <!-- Streaming service bar badge (full-width top bar) -->
        <Rectangle id="serviceBadgeBg"
          width="320"
          height="58"
          translation="[0, 0]"
          color="0xE50914FF"
          visible="false" />
        <Label id="serviceBadge"
          width="320"
          height="32"
          translation="[0, 3]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallBoldSystemFont"
          color="0xFFFFFFFF"
          visible="false" />
        <Label id="serviceBadgeSubtext"
          text="NOW STREAMING"
          width="320"
          height="22"
          translation="[0, 35]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallSystemFont"
          color="0xFFFFFFBF"
          visible="false" />

        <!-- Pre-order badge (top-right, replaces streaming badge) -->
        <Rectangle id="preOrderBadgeBg"
          width="90"
          height="51"
          translation="[224, 6]"
          color="0x7C3AEDFF"
          visible="false" />
        <Label id="preOrderBadgeLabel"
          width="90"
          height="29"
          translation="[224, 6]"
          horizAlign="center"
          vertAlign="bottom"
          font="font:SmallBoldSystemFont"
          color="0xFFFFFFFF"
          visible="false" />
        <Label id="preOrderBadgeDate"
          width="90"
          height="26"
          translation="[224, 29]"
          horizAlign="center"
          vertAlign="top"
          font="font:SmallSystemFont"
          color="0xFFFFFFFF"
          visible="false" />

        <!-- Restoration badge (top-right) -->
        <Rectangle id="restorationBadgeBg"
          width="102"
          height="35"
          translation="[212, 6]"
          color="0xC8A951FF"
          visible="false" />
        <Label id="restorationBadgeLabel"
          text="RESTORATION"
          width="102"
          height="35"
          translation="[212, 6]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallBoldSystemFont"
          color="0x000000FF"
          visible="false" />

        <!-- Virtual screening top banner (full width, top of poster) -->
        <Rectangle id="screeningTopBannerBg"
          width="320"
          height="35"
          translation="[0, 0]"
          color="0xFFD700EB"
          visible="false" />
        <Label id="screeningTopBannerLabel"
          text="VIRTUAL SCREENING"
          width="320"
          height="35"
          translation="[0, 0]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallBoldSystemFont"
          color="0x000000FF"
          visible="false" />

        <!-- Virtual screening festival name strip (bottom of poster) -->
        <Rectangle id="screeningFestivalBg"
          width="320"
          height="38"
          translation="[0, 442]"
          color="0xFFD700FF"
          visible="false" />
        <Label id="screeningFestivalLabel"
          width="314"
          height="38"
          translation="[3, 442]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallBoldSystemFont"
          color="0x000000FF"
          visible="false" />

        <!-- Metacritic score badge (bottom, left of IMDb) -->
        <Rectangle id="mcBadgeBorder"
          width="67"
          height="38"
          translation="[114, 437]"
          color="0x7DDF648C"
          visible="false" />
        <Rectangle id="mcBadgeBg"
          width="64"
          height="35"
          translation="[115, 438]"
          color="0x7DDF6414"
          visible="false" />
        <Label id="mcBadge"
          width="64"
          height="35"
          translation="[115, 438]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallSystemFont"
          color="0x7DDF64FF"
          visible="false" />

        <!-- IMDb rating badge (bottom-right, left of RT) -->
        <Rectangle id="imdbBadgeBorder"
          width="61"
          height="38"
          translation="[184, 437]"
          color="0xF5C5188C"
          visible="false" />
        <Rectangle id="imdbBadgeBg"
          width="58"
          height="35"
          translation="[186, 438]"
          color="0xF5C51814"
          visible="false" />
        <Label id="imdbBadge"
          width="58"
          height="35"
          translation="[186, 438]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallSystemFont"
          color="0xF5C518FF"
          visible="false" />

        <!-- RT score badge (bottom-right) -->
        <Rectangle id="rtBadgeBorder"
          width="74"
          height="38"
          translation="[242, 437]"
          color="0xFF6B6B8C"
          visible="false" />
        <Rectangle id="rtBadgeBg"
          width="70"
          height="35"
          translation="[243, 438]"
          color="0xFF6B6B14"
          visible="false" />
        <Label id="rtBadge"
          width="70"
          height="35"
          translation="[243, 438]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallSystemFont"
          color="0xFF6B6BFF"
          visible="false" />

        <!-- Staff Pick strip (bottom) -->
        <Rectangle id="staffPickStrip"
          width="320"
          height="10"
          translation="[0, 480]"
          color="0x00D4AAFF"
          visible="false" />

        <!-- SELECT pill (top-center): teal outline + dark glass + label.
             Built as outer/inner rects (Roku has no rounded/bordered rects),
             same pattern as the score badges. -->
        <Rectangle id="staffPickPillBorder"
          width="250"
          height="36"
          translation="[35, 6]"
          color="0x00D4AAFF"
          visible="false" />
        <Rectangle id="staffPickPillBg"
          width="246"
          height="32"
          translation="[37, 8]"
          color="0x081412FF"
          visible="false" />
        <Label id="staffPickCardLabel"
          text="★ NRW SELECT ★"
          width="246"
          height="32"
          translation="[37, 8]"
          horizAlign="center"
          vertAlign="center"
          font="font:SmallBoldSystemFont"
          color="0x00FFBBFF"
          visible="false" />
      </Group>

      <!-- Director name (below poster) -->
      <Label id="directorLabel"
        width="320"
        height="38"
        translation="[0, 10]"
        horizAlign="center"
        font="font:SmallSystemFont"
        color="0xBBBBBBFF"
        maxLines="1"
        ellipsisText="..." />

      <!-- Virtual screening days-left (below director; red when ≤3 days, gold/gray otherwise) -->
      <Label id="screeningDaysLabel"
        width="320"
        height="34"
        translation="[0, 2]"
        horizAlign="center"
        font="font:MediumBoldSystemFont"
        color="0xFFD700FF"
        maxLines="1"
        visible="false" />

    </LayoutGroup>


  </children>
</component>
