<?xml version="1.0" encoding="utf-8" ?>
<!--
  NRW Filter Bar Component
  Horizontal row of filter chips
  Matches tvOS FilterSidebar and Android FilterChips
-->
<component name="FilterBar" extends="Group">
  <interface>
    <!-- Current filter selection (signals which filter was just pressed) -->
    <field id="selectedFilter" type="string" value="" onChange="onFilterChanged" alwaysNotify="true" />

    <!-- Active filters array (multi-select state) -->
    <field id="activeFilters" type="array" value="[]" onChange="onFilterChanged" />

    <!-- Focus -->
    <field id="hasFocus" type="boolean" value="false" onChange="onFocusChanged" />
    <field id="focusedIndex" type="integer" value="0" />
  </interface>

  <script type="text/brightscript" uri="FilterBar.brs" />
  <script type="text/brightscript" uri="pkg:/source/constants/Colors.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/MovieUtils.brs" />

  <children>
    <!-- Filter chips row -->
    <LayoutGroup id="filterRow"
      layoutDirection="horiz"
      itemSpacings="[12]"
      translation="[60, 0]">

      <!-- Pre-Orders -->
      <Group id="chip_pre_orders">
        <Rectangle id="chipBg_pre_orders" width="110" height="36" color="0x333333FF" />
        <Label id="chipLabel_pre_orders" text="Pre-Orders" width="110" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Studio -->
      <Group id="chip_studio">
        <Rectangle id="chipBg_studio" width="80" height="36" color="0x333333FF" />
        <Label id="chipLabel_studio" text="Studio" width="80" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Indie -->
      <Group id="chip_indie">
        <Rectangle id="chipBg_indie" width="60" height="36" color="0x333333FF" />
        <Label id="chipLabel_indie" text="Indie" width="60" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- NRW Picks -->
      <Group id="chip_staff_picks">
        <Rectangle id="chipBg_staff_picks" width="110" height="36" color="0x333333FF" />
        <Label id="chipLabel_staff_picks" text="NRW Picks" width="110" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Foreign -->
      <Group id="chip_foreign">
        <Rectangle id="chipBg_foreign" width="80" height="36" color="0x333333FF" />
        <Label id="chipLabel_foreign" text="Foreign" width="80" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Miniseries -->
      <Group id="chip_series">
        <Rectangle id="chipBg_series" width="100" height="36" color="0x333333FF" />
        <Label id="chipLabel_series" text="Miniseries" width="100" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Reissues -->
      <Group id="chip_restorations">
        <Rectangle id="chipBg_restorations" width="90" height="36" color="0x333333FF" />
        <Label id="chipLabel_restorations" text="Reissues" width="90" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Docs -->
      <Group id="chip_documentary">
        <Rectangle id="chipBg_documentary" width="60" height="36" color="0x333333FF" />
        <Label id="chipLabel_documentary" text="Docs" width="60" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- V. Screenings -->
      <Group id="chip_virtual_screenings">
        <Rectangle id="chipBg_virtual_screenings" width="130" height="36" color="0x333333FF" />
        <Label id="chipLabel_virtual_screenings" text="V. Screenings" width="130" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>
    </LayoutGroup>

    <!-- Focus indicator -->
    <Rectangle id="focusIndicator"
      height="3"
      color="0x00D4AAFF"
      translation="[60, 38]"
      visible="false" />
  </children>
</component>
