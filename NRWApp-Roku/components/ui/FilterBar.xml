<?xml version="1.0" encoding="utf-8" ?>
<!--
  NRW Filter Bar Component
  Horizontal row of filter chips
  Matches tvOS FilterSidebar and Android FilterChips
-->
<component name="FilterBar" extends="Group">
  <interface>
    <!-- Current filter selection (signals which filter was just pressed) -->
    <field id="selectedFilter" type="string" value="" onChange="onFilterChanged" alwaysNotify="true" />

    <!-- Active filters array (multi-select state) -->
    <field id="activeFilters" type="array" value="[]" onChange="onFilterChanged" />

    <!-- Slop mode: "free" | "all" | "only" -->
    <field id="slopMode" type="string" value="free" onChange="onFilterChanged" />

    <!-- Hide virtual screenings toggle state -->
    <field id="hideFest" type="boolean" value="true" onChange="onFilterChanged" />

    <!-- Show pre-orders toggle state -->
    <field id="showPreorders" type="boolean" value="false" onChange="onFilterChanged" />

    <!-- Focus -->
    <field id="hasFocus" type="boolean" value="false" onChange="onFocusChanged" />
    <field id="focusedIndex" type="integer" value="0" />
  </interface>

  <script type="text/brightscript" uri="FilterBar.brs" />
  <script type="text/brightscript" uri="pkg:/source/constants/Colors.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/MovieUtils.brs" />

  <children>
    <!-- Filter chips row -->
    <LayoutGroup id="filterRow"
      layoutDirection="horiz"
      itemSpacings="[12]"
      translation="[60, 0]">

      <!-- Picks -->
      <Group id="chip_staff_picks">
        <Rectangle id="chipBg_staff_picks" width="70" height="36" color="0x333333FF" />
        <Label id="chipLabel_staff_picks" text="Picks" width="70" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Indie -->
      <Group id="chip_indie">
        <Rectangle id="chipBg_indie" width="60" height="36" color="0x333333FF" />
        <Label id="chipLabel_indie" text="Indie" width="60" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Horror -->
      <Group id="chip_horror">
        <Rectangle id="chipBg_horror" width="80" height="36" color="0x333333FF" />
        <Label id="chipLabel_horror" text="Horror" width="80" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Action -->
      <Group id="chip_action">
        <Rectangle id="chipBg_action" width="80" height="36" color="0x333333FF" />
        <Label id="chipLabel_action" text="Action" width="80" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Comedy -->
      <Group id="chip_comedy">
        <Rectangle id="chipBg_comedy" width="80" height="36" color="0x333333FF" />
        <Label id="chipLabel_comedy" text="Comedy" width="80" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Family -->
      <Group id="chip_family">
        <Rectangle id="chipBg_family" width="80" height="36" color="0x333333FF" />
        <Label id="chipLabel_family" text="Family" width="80" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Thriller -->
      <Group id="chip_thriller">
        <Rectangle id="chipBg_thriller" width="80" height="36" color="0x333333FF" />
        <Label id="chipLabel_thriller" text="Thriller" width="80" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Foreign -->
      <Group id="chip_foreign">
        <Rectangle id="chipBg_foreign" width="80" height="36" color="0x333333FF" />
        <Label id="chipLabel_foreign" text="Foreign" width="80" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Docs -->
      <Group id="chip_documentary">
        <Rectangle id="chipBg_documentary" width="60" height="36" color="0x333333FF" />
        <Label id="chipLabel_documentary" text="Docs" width="60" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Reissues -->
      <Group id="chip_restorations">
        <Rectangle id="chipBg_restorations" width="90" height="36" color="0x333333FF" />
        <Label id="chipLabel_restorations" text="Reissues" width="90" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
      </Group>

      <!-- Divider -->
      <Rectangle id="filterDivider" width="1" height="28" color="0x444444FF"
        translation="[0, 4]" />

      <!-- Slop Toggle -->
      <Group id="chip_slop_free">
        <Rectangle id="chipBg_slop_free" width="120" height="36" color="0x00342AFF" />
        <Label id="chipLabel_slop_free" text="SLOP FREE" width="120" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0x00D4AAFF" />
      </Group>

      <!-- Fest Toggle: dim = fests hidden (default), teal = fests shown -->
      <Group id="chip_hide_fest">
        <Rectangle id="chipBg_hide_fest" width="110" height="36" color="0x0D0D0DFF" />
        <Label id="chipLabel_hide_fest" text="NO FEST" width="110" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0x00D4AA73" />
      </Group>

      <!-- Pre-Orders Toggle -->
      <Group id="chip_show_preorders">
        <Rectangle id="chipBg_show_preorders" width="130" height="36" color="0x0D0D0DFF" />
        <Label id="chipLabel_show_preorders" text="NO PRE-ORDERS" width="130" height="36"
          horizAlign="center" vertAlign="center"
          font="font:SmallBoldSystemFont" color="0x59595959" />
      </Group>
    </LayoutGroup>

    <!-- Focus indicator -->
    <Rectangle id="focusIndicator"
      height="3"
      color="0x00D4AAFF"
      translation="[60, 38]"
      visible="false" />
  </children>
</component>
